# Public site origin, used for canonical + Open Graph URLs
VITE_SITE_ORIGIN=https://farmreach.in

# Farminsta OS destination — the ONE place this URL is configured
VITE_FARMINSTA_URL=https://farminsta.com

# Contact form endpoint. Defaults to /api/contact; leave blank to run the form
# in validate-only mode (design review builds).
VITE_CONTACT_ENDPOINT=

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY — never VITE_ prefixed, never bundled into the frontend.
# Consumed by api/contact.js + api/_lib/mailer.js.
# ---------------------------------------------------------------------------
# Internal enquiry recipients
ENQUIRY_TO=ypr@farmreach.in
ENQUIRY_CC=abila@farmreach.in

# Email provider: resend | smtp | console (console = log only, no send)
MAIL_PROVIDER=
MAIL_FROM=Farmreach <website@farmreach.in>
RESEND_API_KEY=
SMTP_URL=
